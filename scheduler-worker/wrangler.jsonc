{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "panlayer-background-scheduler",
  "main": "./index.js",
  "compatibility_date": "2026-07-24",
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "vars": {
    "PANLAYER_TARGET_URL": "https://panlayer-market-review.lihaozheng567.chatgpt.site/api/v1/internal/scheduler/tick"
  },
  "triggers": {
    "crons": [
      "17 * * * *",
      "50,55 22 * * *",
      "15 23 * * *",
      "30 0 * * *",
      "30 17 * * *",
      "25 1 * * MON-FRI",
      "0 2 * * MON-FRI",
      "0 3 * * MON-FRI",
      "0 5 * * MON-FRI",
      "0 6 * * MON-FRI",
      "0 7 * * MON-FRI",
      "30 7 * * MON-FRI",
      "10 8 * * MON-FRI",
      "0,30 10-15 * * *"
    ]
  }
}
